+ * (INCLUDING NEGLIGENCE OR OTHERWISE) ARISING IN ANY WAY OUT OF THE USE OF
+ * THIS SOFTWARE, EVEN IF ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.
+ */
+
+#include "config.h"
+#include "JSGlueBase.h"
+
+JSGlueBase::JSGlueBase(JSTypeID type) : fTypeID(type), fRetainCount(1)
+{
+}
+
+JSGlueBase::~JSGlueBase()
+{
+}
+
+JSGlueBase* JSGlueBase::Retain()
+{
+    fRetainCount++; return this;
+}
+
+void JSGlueBase::Release()
+{
+    if (--fRetainCount == 0)
+    {
+        JSGlueAPIEntry entry;
+        delete this;
+    }
+}
+
+CFIndex JSGlueBase::RetainCount() const
+{
+    return fRetainCount;
+}
+
+JSTypeID JSGlueBase::GetTypeID() const
+{
+    return fTypeID;
+}
+
+CFStringRef JSGlueBase::CopyDescription()
+{
+    return CFStringCreateWithFormat(
+                0,
+                0,
+                CFSTR("<JSTypeRef- ptr:0x%lx type: %d, retaincount: %ld>"),
+                (long)this,
+                (int)fTypeID,
+                (long)fRetainCount);
+}
+
+UInt8 JSGlueBase::Equal(JSGlueBase* other)
+{
+    return this == other;
+}
