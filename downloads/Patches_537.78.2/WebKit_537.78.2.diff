+
+#include <dispatch/object.h>
+#include <PLBlocks/Block.h>
+#include <libkern/OSAtomic.h>
+#include <stdlib.h>
+
+typedef struct dispatch_object_s* dispatch_object_tt;
+
+void dispatch_retain(dispatch_object_tt object)
+{
+  OSAtomicIncrement32(&object->retain_count);
+}
+
+void dispatch_release(dispatch_object_tt object)
+{
+  int count = OSAtomicDecrement32(&object->retain_count);
+  if (count == 0)
+  {
+    dispatch_function_t finaliser = object->finaliser;
+    void *context = object->context;
+    
+    // do internal dealloc if we've got one
+    if (object->dealloc)
+    {
+      object->dealloc();
+      Block_release(object->dealloc);
+    }
+    
+    if (object->suspend)
+    {
+      object->suspend();
+      Block_release(object->suspend);
+    }
+    
+    if (object->resume)
+    {
+      Block_release(object->resume);
+    }
+    
+    // do the actual release
+    free(object);
+    
+    // call the finaliser function
+    if (finaliser != NULL)
+    {
+      finaliser(context);
+    }
+  }
+}
+
+void dispatch_suspend(dispatch_object_tt object)
+{
+  if (object->suspend)
+  {
+    int count = object->suspend_count;
+    
+    OSAtomicIncrement32(&object->suspend_count);
+    
+    // we weren't suspended before
+    if (count == 0)
+    {
+      object->suspend();
+    }
+  }
+  else
+  {
+    WW_ERROR("dispatch_suspect: this object does not implement suspend\n");
+  }
+}
+
+void dispatch_resume(dispatch_object_tt object)
+{
+  if (object->resume)
+  {
+    int count = OSAtomicDecrement32(&object->suspend_count);
+    
+    // we were suspended before
+    if (count == 0)
+    {
+      object->resume();
+    }
+  }
+  else
+  {
+    WW_ERROR("dispatch_suspect: this object does not implement suspend\n");
+  }
+}
+
+void dispatch_set_finalizer_f(dispatch_object_tt object, dispatch_function_t finaliser)
+{
+  object->finaliser = finaliser;
+}
+
+void *dispatch_get_context(dispatch_object_tt object)
+{
+  return object->context;
+}
+ 
+void dispatch_set_context(dispatch_object_tt object, void *context)
+{ 
+  object->context = context;
+} 
