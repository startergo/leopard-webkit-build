+        static void relinkJump(void* from, void* target)
+        {
+            void *stanza_start = (void *)(intptr_t(from) - PPC_BRANCH_STANZA_LENGTH);
+            bool needRelocation = patchBranch(stanza_start, target);
+#if !defined(_ARCH_PWR4)
+            ASSERT(!needRelocation);
+#endif
