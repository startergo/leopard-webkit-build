+    id object = [info objectForKey:@"object"];
+    NSDictionary *userInfo = [info objectForKey:@"userInfo"];
+
+    [[self defaultCenter] postNotificationName:name object:object userInfo:userInfo];
+
+    [info release];
+}
+
