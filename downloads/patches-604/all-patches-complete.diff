+        void bcctr(CRegisterID cr, int op,
+                   BranchLikelihood likely, BranchLink is_link) {
+            ASSERT(op < 256);
+            int bi = (cr << 2) + (op >> 4);
+            int bo = (op & 15);
+            m_buffer.putInt(PPC_bcctr | (bo | likely)<<21 | bi<<16 | is_link);
+        }
