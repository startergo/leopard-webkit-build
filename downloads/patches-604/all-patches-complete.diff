+        } else {
+            if (PPC_IMM_OK_U(mask))
+                m_assembler.andi_rc(tempRegister, reg, mask.m_value);
+            else {
+                m_assembler.x_li32(tempRegister, mask.m_value);
+                m_assembler.and_rc(tempRegister, reg, tempRegister);
+            }
+        }
+    }
