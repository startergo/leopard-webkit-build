From e2e6910224a1fb5c2ebaee2994137a34d2b07756 Mon Sep 17 00:00:00 2001
From: startergo <7897244+startergo@users.noreply.github.com>
Date: Wed, 24 Jun 2026 19:58:30 -0500
Subject: [PATCH 29/39] [sl-port-610] Fix GitHub/modern sites rendering
 unstyled: 10.6's HTTP stack cannot decode Brotli (Content-Encoding: br), but
 CDNs (github.githubassets.com) serve br when advertised -> undecodable empty
 body -> CSS/JS fail to load (0 bytes transferred). Force Accept-Encoding:
 gzip, deflate AFTER the header re-apply loop in doUpdatePlatformRequest so it
 is not overwritten. Servers then send 10.6-decodable gzip

---
 .../platform/network/cocoa/ResourceRequestCocoa.mm        | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/Source/WebCore/platform/network/cocoa/ResourceRequestCocoa.mm b/Source/WebCore/platform/network/cocoa/ResourceRequestCocoa.mm
index aa36fa352e..c9b24e1772 100644
--- a/Source/WebCore/platform/network/cocoa/ResourceRequestCocoa.mm
+++ b/Source/WebCore/platform/network/cocoa/ResourceRequestCocoa.mm
@@ -201,6 +201,14 @@ void ResourceRequest::doUpdatePlatformRequest()
     for (const auto& header : httpHeaderFields())
         [nsRequest setValue:header.value forHTTPHeaderField:header.key];
 
+    // [leopard] 10.6's HTTP stack cannot decode Brotli (Content-Encoding: br). Modern
+    // CDNs (e.g. github.githubassets.com) serve br when it is advertised, and the
+    // undecodable body comes back empty -> CSS/JS silently fail to load (pages render
+    // unstyled with no scripts). Force Accept-Encoding to gzip/deflate AFTER the header
+    // copy above (which would otherwise restore a br-containing value), so the server
+    // sends a 10.6-decodable encoding.
+    [nsRequest setValue:@"gzip, deflate" forHTTPHeaderField:@"Accept-Encoding"];
+
     [nsRequest setContentDispositionEncodingFallbackArray:createNSArray(m_responseContentDispositionEncodingFallbackArray, [] (auto& name) -> NSNumber * {
         auto encoding = CFStringConvertEncodingToNSStringEncoding(CFStringConvertIANACharSetNameToEncoding(name.createCFString().get()));
         if (encoding == kCFStringEncodingInvalidId)
