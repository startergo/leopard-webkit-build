From e68eb77741bbd205dfb15c3769e7d35b7c637373 Mon Sep 17 00:00:00 2001
From: startergo <7897244+startergo@users.noreply.github.com>
Date: Thu, 25 Jun 2026 22:09:44 -0400
Subject: [PATCH 41/41] [sl-port-610] Use 10.6-native NSGraphicsContext
 graphics-port APIs instead of 10.10+ CGContext APIs in the AppKit
 current-context setup.

Two WebCore sites set up the current NSGraphicsContext for AppKit-routed drawing (NSCell, theme, form controls, glyphs) using +[NSGraphicsContext graphicsContextWithCGContext:flipped:] and -[NSGraphicsContext CGContext]. Both are 10.10+ APIs and are ABSENT from the 10.6 SDK (verified: graphicsContextWithCGContext and -CGContext do not appear in 10.6 AppKit headers; the 10.6-era graphicsContextWithGraphicsPort:flipped: and -graphicsPort ARE present, NSGraphicsContext.h). On 10.6 the 10.10+ selectors return nil / wrong values, leaving AppKit drawing without a valid current context.

LocalCurrentGraphicsContextMac.mm: the pervasive RAII helper that makes a CGContext current for AppKit. Swap graphicsContextWithCGContext: -> graphicsContextWithGraphicsPort:, and the early-return probe [currentContext CGContext] -> (CGContextRef)[currentContext graphicsPort]. Both APIs wrap/return the same CGContext, so behavior is preserved on newer systems and corrected on 10.6.

PlatformCALayerCocoa.mm drawLayerContents: same graphicsContextWithCGContext: -> graphicsContextWithGraphicsPort: swap in the CALayer content-paint setup.

Note: this does NOT by itself make BBC composited text paint -- that path (PlatformCALayer::drawLayerContents via WebLayer -drawInContext:) is not being invoked at all on the software-GPU VM, which is a separate compositing/display issue still under investigation. These swaps fix the latent nil-current-context bug for the AppKit drawing paths that DO run on 10.6 (theme/control/glyph drawing through LocalCurrentGraphicsContext).
---
 .../platform/graphics/ca/cocoa/PlatformCALayerCocoa.mm        | 2 +-
 Source/WebCore/platform/mac/LocalCurrentGraphicsContextMac.mm | 4 ++--
 2 files changed, 3 insertions(+), 3 deletions(-)

diff --git a/Source/WebCore/platform/graphics/ca/cocoa/PlatformCALayerCocoa.mm b/Source/WebCore/platform/graphics/ca/cocoa/PlatformCALayerCocoa.mm
index f2ee76227d..d55424c08d 100644
--- a/Source/WebCore/platform/graphics/ca/cocoa/PlatformCALayerCocoa.mm
+++ b/Source/WebCore/platform/graphics/ca/cocoa/PlatformCALayerCocoa.mm
@@ -1197,7 +1197,7 @@ void PlatformCALayer::drawLayerContents(GraphicsContext& graphicsContext, WebCor
 
         // Set up an NSGraphicsContext for the context, so that parts of AppKit that rely on
         // the current NSGraphicsContext (e.g. NSCell drawing) get the right one.
-        NSGraphicsContext* layerContext = [NSGraphicsContext graphicsContextWithCGContext:context flipped:YES];
+        NSGraphicsContext* layerContext = [NSGraphicsContext graphicsContextWithGraphicsPort:context flipped:YES];
         [NSGraphicsContext setCurrentContext:layerContext];
 #endif
     }
diff --git a/Source/WebCore/platform/mac/LocalCurrentGraphicsContextMac.mm b/Source/WebCore/platform/mac/LocalCurrentGraphicsContextMac.mm
index a41eb4ad88..2db9cc2342 100644
--- a/Source/WebCore/platform/mac/LocalCurrentGraphicsContextMac.mm
+++ b/Source/WebCore/platform/mac/LocalCurrentGraphicsContextMac.mm
@@ -37,11 +37,11 @@ LocalCurrentGraphicsContext::LocalCurrentGraphicsContext(GraphicsContext& graphi
     }
 
     CGContextRef cgContext = this->cgContext();
-    if (cgContext == [[NSGraphicsContext currentContext] CGContext])
+    if (cgContext == (CGContextRef)[[NSGraphicsContext currentContext] graphicsPort])
         return;
 
     m_savedNSGraphicsContext = [NSGraphicsContext currentContext];
-    NSGraphicsContext* newContext = [NSGraphicsContext graphicsContextWithCGContext:cgContext flipped:YES];
+    NSGraphicsContext* newContext = [NSGraphicsContext graphicsContextWithGraphicsPort:cgContext flipped:YES];
     [NSGraphicsContext setCurrentContext:newContext];
     m_didSetGraphicsContext = true;
 }
