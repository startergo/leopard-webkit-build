From e2873a5be001d1edba91621f16c01964f1400813 Mon Sep 17 00:00:00 2001
From: startergo <7897244+startergo@users.noreply.github.com>
Date: Wed, 24 Jun 2026 11:26:17 -0500
Subject: [PATCH 19/39] [sl-port-610] Fix Web Inspector / context-menu crash:
 +[NSMenuItem standardShareMenuItemForItems:] (10.8+) called unguarded when
 building context menu (Inspect Element) -> unrecognized selector abort on
 10.6. Guard with respondsToSelector:, omit Share item on 10.6

---
 Source/WebKitLegacy/mac/WebView/WebHTMLView.mm | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/Source/WebKitLegacy/mac/WebView/WebHTMLView.mm b/Source/WebKitLegacy/mac/WebView/WebHTMLView.mm
index 4ae0a63374..74e4e2e380 100644
--- a/Source/WebKitLegacy/mac/WebView/WebHTMLView.mm
+++ b/Source/WebKitLegacy/mac/WebView/WebHTMLView.mm
@@ -3612,6 +3612,12 @@ static RetainPtr<NSMenuItem> createShareMenuItem(const WebCore::HitTestResult& h
     if (![items count])
         return nil;
 
+    // [leopard] +[NSMenuItem standardShareMenuItemForItems:] is 10.8+; on 10.6 it is
+    // an unrecognized selector (crashes building the context menu, e.g. when opening
+    // the Web Inspector via Inspect Element). No system Share menu on 10.6; omit it.
+    if (![NSMenuItem respondsToSelector:@selector(standardShareMenuItemForItems:)])
+        return nil;
+
     return [NSMenuItem standardShareMenuItemForItems:items.get()];
 }
 
-- 
