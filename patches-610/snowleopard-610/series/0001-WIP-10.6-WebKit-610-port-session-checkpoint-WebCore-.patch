+# [leopard-webkit-build] Match the JSCOnly port's ICU config (and the working 605
+# build): disable ICU symbol renaming so the unversioned C API names the Intl code
+# calls (ufieldpositer_open, uplrules_select, UDAT_*_FIELD, etc.) resolve against
+# the bundled static ICU 55, and pin U_SHOW_CPLUSPLUS_API=0 to avoid the C++ API.
+add_definitions(-DU_DISABLE_RENAMING=1)
+add_definitions(-DUCHAR_TYPE=uint16_t)  # [leopard] match libxml2's UChar (uint16_t) to avoid char16_t typedef conflict
+add_definitions(-DU_SHOW_CPLUSPLUS_API=0)
+# [leopard] Expose ICU draft APIs (ufieldpositer_*, UFieldPositionIterator, the
+# draft UDAT_*_FIELD enums) which ICU 55 gates behind U_HIDE_DRAFT_API.
+add_definitions(-DU_SHOW_DRAFT_API=1)
+
+# [leopard] Suppress ANGLE's raw GLES C prototypes (glShaderSource, glTexImage2D, etc. in
+# gl2.h/gl.h/gl2ext.h). WebCore's ANGLE backend calls ANGLE through its gl::EntryPoint C++
+# functions, so the raw prototypes are unused -- and they conflict with the 10.6 system
+# <OpenGL/gl.h> prototypes pulled in transitively by the CGL headers (CGLContext.h ->
+# gliDispatch.h -> gl.h). Pre-defining the prototype guards to 0 elides the ANGLE prototypes
+# while leaving its typedefs and entry points intact, so ANGLE/WebGL stays fully functional.
+add_definitions(-DGL_GLES_PROTOTYPES=0)
