From 5bbd3e89000b19bb6295685c267f81266fba4c35 Mon Sep 17 00:00:00 2001
From: startergo <7897244+startergo@users.noreply.github.com>
Date: Wed, 24 Jun 2026 20:16:13 -0500
Subject: [PATCH 30/36] [sl-port-610] Two Inspector-robustness fixes: (1)
 RenderThemeMac search() called -[NSSearchFieldCell setCenteredLook:] (10.7+
 SPI) unguarded -> crash rendering search fields (Inspector console filter).
 Guard with respondsToSelector:. (2) Layers3DContentView layout() drove the
 document/layer update chain (deref of null this._scene) even when WebGL was
 unavailable and the renderer was never created -> crash on selecting the
 Layers tab. Early-return from layout() when there is no renderer

---
 Source/WebCore/rendering/RenderThemeMac.mm                  | 6 +++++-
 .../UserInterface/Views/Layers3DContentView.js              | 6 ++++++
 2 files changed, 11 insertions(+), 1 deletion(-)

diff --git a/Source/WebCore/rendering/RenderThemeMac.mm b/Source/WebCore/rendering/RenderThemeMac.mm
index d51e02a131..9f5862ba81 100644
--- a/Source/WebCore/rendering/RenderThemeMac.mm
+++ b/Source/WebCore/rendering/RenderThemeMac.mm
@@ -2354,7 +2354,11 @@ NSSearchFieldCell* RenderThemeMac::search() const
         [m_search.get() setBezeled:YES];
         [m_search.get() setEditable:YES];
         [m_search.get() setFocusRingType:NSFocusRingTypeExterior];
-        [m_search.get() setCenteredLook:NO];
+        // [leopard] -[NSSearchFieldCell setCenteredLook:] is a 10.7+ private SPI; absent
+        // on 10.6 -> unrecognized selector when rendering search fields (e.g. the Web
+        // Inspector console filter box). Guard it; the centered look is cosmetic.
+        if ([m_search.get() respondsToSelector:@selector(setCenteredLook:)])
+            [m_search.get() setCenteredLook:NO];
     }
 
     return m_search.get();
diff --git a/Source/WebInspectorUI/UserInterface/Views/Layers3DContentView.js b/Source/WebInspectorUI/UserInterface/Views/Layers3DContentView.js
index a76fb79968..94467e557f 100644
--- a/Source/WebInspectorUI/UserInterface/Views/Layers3DContentView.js
+++ b/Source/WebInspectorUI/UserInterface/Views/Layers3DContentView.js
@@ -222,6 +222,12 @@ WI.Layers3DContentView = class Layers3DContentView extends WI.ContentView
 
     layout()
     {
+        // [leopard] When WebGL is unavailable the 3D renderer/scene were never created
+        // (see initialLayout), so the document/layer update chain below would deref a
+        // null this._scene. Skip it entirely; the "unavailable" placeholder is shown.
+        if (!this._renderer)
+            return;
+
         if (this.layoutReason === WI.View.LayoutReason.Resize)
             return;
 
