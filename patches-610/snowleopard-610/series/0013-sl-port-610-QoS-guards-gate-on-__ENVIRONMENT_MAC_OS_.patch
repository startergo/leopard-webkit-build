Date: Wed, 24 Jun 2026 08:42:47 -0500
Subject: [PATCH 13/41] =?UTF-8?q?[sl-port-610]=20QoS=20guards:=20gate=20on?=
 =?UTF-8?q?=20=5F=5FENVIRONMENT=5FMAC=5FOS=5FX=5FVERSION=5FMIN=5FREQUIRED?=
 =?UTF-8?q?=5F=5F=20(=3D1060)=20not=20=5F=5FMAC=5FOS=5FX=5FVERSION=5FMIN?=
 =?UTF-8?q?=5FREQUIRED=20(undefined=20in=20this=20toolchain/SDK).=20Verifi?=
 =?UTF-8?q?ed=20QOS=5FDISABLED=20on=2010.6=20=E2=80=94=20fixes=20the=20no-?=
 =?UTF-8?q?op=20guard=20from=208bbbd8e8?=
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

---
 Source/WTF/wtf/PlatformHave.h        | 11 ++++++-----
 Source/bmalloc/bmalloc/Scavenger.cpp | 11 +++++------
 2 files changed, 11 insertions(+), 11 deletions(-)

diff --git a/Source/WTF/wtf/PlatformHave.h b/Source/WTF/wtf/PlatformHave.h
index d9a566818b..8ae3867c69 100644
--- a/Source/WTF/wtf/PlatformHave.h
+++ b/Source/WTF/wtf/PlatformHave.h
@@ -281,13 +281,14 @@
 #define HAVE_NSCURSOR 1
 #endif
 
-#if !defined(HAVE_QOS_CLASSES) && PLATFORM(COCOA) && (!defined(__MAC_OS_X_VERSION_MIN_REQUIRED) || __MAC_OS_X_VERSION_MIN_REQUIRED >= 1090)
+#if !defined(HAVE_QOS_CLASSES) && PLATFORM(COCOA) && !(defined(__ENVIRONMENT_MAC_OS_X_VERSION_MIN_REQUIRED__) && __ENVIRONMENT_MAC_OS_X_VERSION_MIN_REQUIRED__ < 1090)
 // [leopard] QoS classes (pthread_set_qos_class_self_np / pthread_attr_set_qos_
 // class_np / QOS_CLASS_*) are 10.10+. On 10.6 these symbols are unbound, so any
-// HAVE(QOS_CLASSES)-guarded call jumps to NULL (SIGSEGV) - observed on the
-// bmalloc scavenger thread under memory pressure (youtube.com). WTF/bmalloc
-// compiles do NOT force-include the LEOPARD_WEBKIT overlay, so gate on the
-// SDK-provided deployment target (always defined) rather than LEOPARD_WEBKIT.
+// HAVE(QOS_CLASSES)-guarded call jumps to NULL (SIGSEGV) - seen on the bmalloc
+// scavenger thread under memory pressure (youtube.com). __MAC_OS_X_VERSION_MIN_
+// REQUIRED is NOT defined by this toolchain/SDK, but the compiler builtin
+// __ENVIRONMENT_MAC_OS_X_VERSION_MIN_REQUIRED__ (=1060 here) always is; gate on
+// it so 10.6 leaves HAVE_QOS_CLASSES undefined and every QoS call compiles out.
 #define HAVE_QOS_CLASSES 1
 #endif
 
diff --git a/Source/bmalloc/bmalloc/Scavenger.cpp b/Source/bmalloc/bmalloc/Scavenger.cpp
index b142eda7db..a3331284b2 100644
--- a/Source/bmalloc/bmalloc/Scavenger.cpp
+++ b/Source/bmalloc/bmalloc/Scavenger.cpp
@@ -536,12 +536,11 @@ void Scavenger::setThreadName(const char* name)
 
 void Scavenger::setSelfQOSClass()
 {
-#if BOS(DARWIN) && (!defined(__MAC_OS_X_VERSION_MIN_REQUIRED) || __MAC_OS_X_VERSION_MIN_REQUIRED >= 1090)
-    // [leopard] pthread_set_qos_class_self_np is 10.10+; on 10.6 the symbol is
-    // unbound and the indirect call jumps to NULL (SIGSEGV at threadRunLoop+535
-    // on the bmalloc scavenger thread, triggered under memory pressure from
-    // heavy pages like youtube.com). QoS is only a thread-priority hint, so
-    // skipping it on 10.6 is harmless.
+#if BOS(DARWIN) && !(defined(__ENVIRONMENT_MAC_OS_X_VERSION_MIN_REQUIRED__) && __ENVIRONMENT_MAC_OS_X_VERSION_MIN_REQUIRED__ < 1090)
+    // [leopard] pthread_set_qos_class_self_np is 10.10+; unbound on 10.6 (NULL
+    // call -> SIGSEGV at threadRunLoop+535 under memory pressure, youtube.com).
+    // bmalloc does not see __MAC_OS_X_VERSION_MIN_REQUIRED; use the compiler
+    // builtin __ENVIRONMENT_MAC_OS_X_VERSION_MIN_REQUIRED__ (=1060 on 10.6).
     pthread_set_qos_class_self_np(requestedScavengerThreadQOSClass(), 0);
 #endif
 }
