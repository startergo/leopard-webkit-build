From e4b105fa68fb686c194367b466a8770b69fbb8fc Mon Sep 17 00:00:00 2001
From: startergo <7897244+startergo@users.noreply.github.com>
Date: Thu, 25 Jun 2026 18:21:44 -0400
Subject: [PATCH 37/38] [sl-port-610] Fix Safari 5.0.5 launch crash: -[NSURL
 _web_URLWithLowercasedScheme] unrecognized selector. Safari 5.0.5 (the WK1
 host on 10.6) calls this WebKit SPI during URL canonicalization, but it was
 deleted upstream in 2015 and is absent from 610 (and 604/605) ->
 doesNotRecognizeSelector -> NSInvalidArgumentException abort at launch.
 Re-add the method as a faithful compat shim to WebNSURLExtras: find the
 scheme byte-range via CFURLGetByteRangeForComponent(kCFURLComponentScheme),
 lowercase only the ASCII scheme bytes (toASCIILower, in scope via using
 namespace WTF), rebuild via +[NSURL _web_URLWithData:]. Uses the file's
 existing URL_BYTES_BUFFER_LENGTH static-buffer-with-malloc-fallback idiom.
 Loaded by WebKit.framework (the WebKitLegacy-in-the-WebKit-slot 10.6
 dyld-compat copy made in build phase 8), so a full repackage is required for
 it to take effect.

---
 Source/WebKitLegacy/mac/Misc/WebNSURLExtras.h |  1 +
 .../WebKitLegacy/mac/Misc/WebNSURLExtras.mm   | 37 +++++++++++++++++++
 2 files changed, 38 insertions(+)

diff --git a/Source/WebKitLegacy/mac/Misc/WebNSURLExtras.h b/Source/WebKitLegacy/mac/Misc/WebNSURLExtras.h
index ec70ea345c..1e178ea8d4 100644
--- a/Source/WebKitLegacy/mac/Misc/WebNSURLExtras.h
+++ b/Source/WebKitLegacy/mac/Misc/WebNSURLExtras.h
@@ -63,6 +63,7 @@
 - (NSURL *)_webkit_canonicalize_with_wtf;
 - (NSURL *)_webkit_URLByRemovingFragment;
 - (NSURL *)_web_URLByRemovingUserInfo;
+- (NSURL *)_web_URLWithLowercasedScheme;
 
 - (BOOL)_webkit_isJavaScriptURL;
 - (BOOL)_webkit_isFileURL;
diff --git a/Source/WebKitLegacy/mac/Misc/WebNSURLExtras.mm b/Source/WebKitLegacy/mac/Misc/WebNSURLExtras.mm
index 7e9892fc3d..2ca97ad283 100644
--- a/Source/WebKitLegacy/mac/Misc/WebNSURLExtras.mm
+++ b/Source/WebKitLegacy/mac/Misc/WebNSURLExtras.mm
@@ -217,6 +217,43 @@ using namespace WTF;
 
     return [NSURL URLWithString:[@"file:" stringByAppendingString:[self absoluteString]]];
 }
+
+- (NSURL *)_web_URLWithLowercasedScheme
+{
+    CFRange range = CFURLGetByteRangeForComponent((CFURLRef)self, kCFURLComponentScheme, nullptr);
+    if (range.location == kCFNotFound)
+        return self;
+
+    UInt8 staticBuffer[URL_BYTES_BUFFER_LENGTH];
+    UInt8 *buffer = staticBuffer;
+    CFIndex bytesFilled = CFURLGetBytes((CFURLRef)self, buffer, URL_BYTES_BUFFER_LENGTH);
+    if (bytesFilled == -1) {
+        CFIndex bytesToAllocate = CFURLGetBytes((CFURLRef)self, nullptr, 0);
+        buffer = static_cast<UInt8 *>(malloc(bytesToAllocate));
+        bytesFilled = CFURLGetBytes((CFURLRef)self, buffer, bytesToAllocate);
+    }
+
+    BOOL changed = NO;
+    for (CFIndex i = 0; i < range.length; ++i) {
+        UInt8 c = buffer[range.location + i];
+        if (c >= 'A' && c <= 'Z') {
+            buffer[range.location + i] = toASCIILower(c);
+            changed = YES;
+        }
+    }
+
+    NSURL *result;
+    if (changed) {
+        NSData *data = [NSData dataWithBytes:buffer length:bytesFilled];
+        result = [NSURL _web_URLWithData:data];
+    } else
+        result = self;
+
+    if (buffer != staticBuffer)
+        free(buffer);
+
+    return result;
+}
 @end
 
 @implementation NSString (WebNSURLExtras)
