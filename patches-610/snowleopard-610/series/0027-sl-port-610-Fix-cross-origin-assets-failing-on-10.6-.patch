From d0aa222a4196098ccd67ab00b1ab11af5a6b2fa4 Mon Sep 17 00:00:00 2001
From: startergo <7897244+startergo@users.noreply.github.com>
Date: Wed, 24 Jun 2026 19:02:17 -0500
Subject: [PATCH 27/41] [sl-port-610] Fix cross-origin assets failing on 10.6
 (GitHub renders unstyled): (1) ResourceResponseCocoa.mm used the 10.7+
 initWithURL:statusCode:HTTPVersion:headerFields: unconditionally -> returns
 nil on 10.6, so the synthetic redirect response is not a valid
 NSHTTPURLResponse and CORS rejects the cross-origin redirect. Add the 10.6
 initWithURL:statusCode:headerFields:requestTime: SPI fallback. (2)
 syntheticRedirectResponse (HSTS scheme-upgrade) lacked
 Access-Control-Allow-Origin, so cross-origin asset redirects
 (github.githubassets.com CSS/JS) were denied. Add ACAO:* . Matches the proven
 605 fix

---
 .../WebCore/platform/network/ResourceResponseBase.cpp |  5 +++++
 .../platform/network/cocoa/ResourceResponseCocoa.mm   | 11 ++++++++++-
 2 files changed, 15 insertions(+), 1 deletion(-)

diff --git a/Source/WebCore/platform/network/ResourceResponseBase.cpp b/Source/WebCore/platform/network/ResourceResponseBase.cpp
index 01d3ddce84..4864de5e85 100644
--- a/Source/WebCore/platform/network/ResourceResponseBase.cpp
+++ b/Source/WebCore/platform/network/ResourceResponseBase.cpp
@@ -144,6 +144,11 @@ ResourceResponse ResourceResponseBase::syntheticRedirectResponse(const URL& from
     redirectResponse.setHTTPVersion("HTTP/1.1"_s);
     redirectResponse.setHTTPHeaderField(HTTPHeaderName::Location, toURL.string());
     redirectResponse.setHTTPHeaderField(HTTPHeaderName::CacheControl, "no-store"_s);
+    // [leopard] Allow CORS redirect checks to pass on synthetic (HSTS scheme-upgrade)
+    // redirects. Without this, a scheme-change redirect to a cross-origin asset host
+    // (e.g. github.githubassets.com for GitHub's CSS/JS) is denied by the CORS check
+    // and the resources fail to load, leaving the page unstyled.
+    redirectResponse.setHTTPHeaderField(HTTPHeaderName::AccessControlAllowOrigin, "*"_s);
 
     return redirectResponse;
 }
diff --git a/Source/WebCore/platform/network/cocoa/ResourceResponseCocoa.mm b/Source/WebCore/platform/network/cocoa/ResourceResponseCocoa.mm
index ad2c9b360d..7a6aa4205a 100644
--- a/Source/WebCore/platform/network/cocoa/ResourceResponseCocoa.mm
+++ b/Source/WebCore/platform/network/cocoa/ResourceResponseCocoa.mm
@@ -64,7 +64,16 @@ void ResourceResponse::initNSURLResponse() const
     for (auto& header : m_httpHeaderFields)
         [headerDictionary setObject:(NSString *)header.value forKey:(NSString *)header.key];
 
-    m_nsResponse = adoptNS([[NSHTTPURLResponse alloc] initWithURL:m_url statusCode:m_httpStatusCode HTTPVersion:(NSString*)kCFHTTPVersion1_1 headerFields:headerDictionary]);
+    // [leopard] The public initWithURL:statusCode:HTTPVersion:headerFields: is 10.7+.
+    // On 10.6, use the private initWithURL:statusCode:headerFields:requestTime: SPI.
+    // Without a proper NSHTTPURLResponse, CORS checks reject cross-origin redirects
+    // (e.g. github.githubassets.com CSS/JS assets fail to load -> unstyled page).
+    if ([NSHTTPURLResponse instancesRespondToSelector:@selector(initWithURL:statusCode:HTTPVersion:headerFields:)])
+        m_nsResponse = adoptNS([[NSHTTPURLResponse alloc] initWithURL:m_url statusCode:m_httpStatusCode HTTPVersion:(NSString*)kCFHTTPVersion1_1 headerFields:headerDictionary]);
+    else if ([NSHTTPURLResponse instancesRespondToSelector:@selector(initWithURL:statusCode:headerFields:requestTime:)])
+        m_nsResponse = adoptNS([[NSHTTPURLResponse alloc] initWithURL:m_url statusCode:m_httpStatusCode headerFields:headerDictionary requestTime:0]);
+    else
+        m_nsResponse = adoptNS([[NSHTTPURLResponse alloc] initWithURL:m_url MIMEType:m_mimeType expectedContentLength:static_cast<NSInteger>(m_expectedContentLength) textEncodingName:nsStringNilIfEmpty(m_textEncodingName)]);
 
     // Mime type sniffing doesn't work with a synthesized response.
     [m_nsResponse.get() _setMIMEType:(NSString *)m_mimeType];
