From 4a3305c8e28b2b985a16d48f8b9e7344bb1dffd0 Mon Sep 17 00:00:00 2001
From: startergo <7897244+startergo@users.noreply.github.com>
Date: Wed, 24 Jun 2026 17:42:40 -0500
Subject: [PATCH 26/38] [sl-port-610] Fix form-field crash:
 -[DOMHTMLInputElement/_TextAreaElement _isEdited] (FormPromptAdditions) was
 gated to PLATFORM(IOS_FAMILY), absent on Mac -> unrecognized selector when
 Safari 5.0.5 desktop wrapper handles text fields (e.g. clicking the Google
 search box). Enable the category on Mac too; lastChangeWasUserEdit() is
 cross-platform

---
 Source/WebKitLegacy/mac/DOM/DOMHTML.mm | 14 +++++++++++++-
 1 file changed, 13 insertions(+), 1 deletion(-)

diff --git a/Source/WebKitLegacy/mac/DOM/DOMHTML.mm b/Source/WebKitLegacy/mac/DOM/DOMHTML.mm
index 97b36bcc78..6d796be116 100644
--- a/Source/WebKitLegacy/mac/DOM/DOMHTML.mm
+++ b/Source/WebKitLegacy/mac/DOM/DOMHTML.mm
@@ -201,7 +201,12 @@
 
 @end
 
-#if PLATFORM(IOS_FAMILY)
+// [leopard] FormPromptAdditions (_isEdited) was restricted to PLATFORM(IOS_FAMILY)
+// upstream, but Safari 5.0.5 (the desktop wrapper hosting this injected WebKit) still
+// sends -[DOMHTMLInputElement _isEdited] when handling text fields -> unrecognized
+// selector crash on 10.6. lastChangeWasUserEdit() is available on all platforms, so
+// compile this category on Mac too.
+#if PLATFORM(IOS_FAMILY) || PLATFORM(MAC)
 
 @implementation DOMHTMLInputElement (FormPromptAdditions)
 
@@ -221,6 +226,13 @@
 
 @end
 
+#endif // PLATFORM(IOS_FAMILY) || PLATFORM(MAC) -- end of _isEdited (Safari 5.0.5 needs it on Mac)
+
+// [leopard] The autocapitalize SPIs below use iOS-only WebCore APIs
+// (AutocapitalizeType / HTMLInputElement::autocapitalizeType()) that do not exist on
+// Mac, so this section stays iOS-only (Safari 5.0.5 desktop does not call them).
+#if PLATFORM(IOS_FAMILY)
+
 static WebAutocapitalizeType webAutocapitalizeType(AutocapitalizeType type)
 {
     switch (type) {
-- 
