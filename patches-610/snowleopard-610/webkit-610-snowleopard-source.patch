+
+
+namespace woff2 {
+
+struct WOFF2Params {
+  WOFF2Params() : extended_metadata(""), brotli_quality(11),
+                  allow_transforms(true) {}
+
+  string extended_metadata;
+  int brotli_quality;
+  bool allow_transforms;
+};
