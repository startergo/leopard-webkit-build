+void ResourceUsageThread::platformCollectCPUData(JSC::VM*, ResourceUsageData&)
+{
+}
+
+void ResourceUsageThread::platformCollectMemoryData(JSC::VM*, ResourceUsageData&)
+{
+}
+#endif // ENABLE(RESOURCE_USAGE)
+
+} // namespace WebCore
+
